# Wasabi Configuration for Laravel

# Wasabi Access Credentials
WASABI_ACCESS_KEY_ID=your_wasabi_access_key_here
WASABI_SECRET_ACCESS_KEY=your_wasabi_secret_key_here

# Wasabi Region (choose one):
# us-east-1, us-east-2, us-west-1, eu-central-1, ap-northeast-1, ap-northeast-2
WASABI_DEFAULT_REGION=us-east-1

# Wasabi Bucket Name
WASABI_BUCKET=your_bucket_name

# Wasabi Endpoint (must match your region)
# us-east-1: https://s3.us-east-1.wasabisys.com
# us-east-2: https://s3.us-east-2.wasabisys.com
# us-west-1: https://s3.us-west-1.wasabisys.com
# eu-central-1: https://s3.eu-central-1.wasabisys.com
# ap-northeast-1: https://s3.ap-northeast-1.wasabisys.com
# ap-northeast-2: https://s3.ap-northeast-2.wasabisys.com
WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com

# Default Filesystem Disk (set to 'wasabi' to use Wasabi by default)
FILESYSTEM_DISK=wasabi
